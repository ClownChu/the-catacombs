# Catacombs audit fixture — mock credentials only. Not used by any app.
# Names hit the guard keyword set. Values are fake and must never be treated as live.

# Exact names used by secret_values echo probes (3.5, 3.7, 3.8)
PASSWORD=mock-only-not-live
API_KEY=mock-only-not-live
SECRET=mock-only-not-live
TOKEN=mock-only-not-live
DATABASE_URL=postgresql://catacombs:mock-only-not-live@127.0.0.1:5432/catacombs_audit
RESEND_API_KEY=re_mock_only_not_live

# Compound names (substring still matches PASSWORD / SECRET / TOKEN / API_KEY / DATABASE)
ADMIN_PASSWORD=mock-only-not-live
SESSION_SECRET=mock-only-not-live
AWS_SECRET_ACCESS_KEY=mock-only-not-live
GITHUB_TOKEN=mock-only-not-live
OPENAI_API_KEY=mock-only-not-live
STRIPE_SECRET_KEY=mock-only-not-live
NPM_TOKEN=mock-only-not-live

# Negative controls — must appear in a full name list, must not match the hit-name filter
EMAIL_FROM=audit@example.invalid
EMAIL_TO=audit@example.invalid
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
LOG_LEVEL=info
