{
  "name": "The Catacombs",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "workspaceMount": "source=${localWorkspaceFolder}/repos,target=/repos,type=bind",
  "workspaceFolder": "/repos",
  "runArgs": [
    "--runtime=runsc",
    "--add-host=host.docker.internal:host-gateway",
    "--memory=6g",
    "--cpus=4.0"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "anysphere.cursor-agent-worker",
        "anysphere.cursor-always-local",
        "anysphere.cursor-resolver",
        "anysphere.cursor-socket",
        "anysphere.cursor-team-kit-skills",
        "dbaeumer.vscode-eslint",
        "mechatroner.rainbow-csv",
        "anysphere.remote-ssh",
        "anysphere.remote-containers",
        "devsense.phptools-vscode",
        "aswinkumar863.smarty-template-support",
        "DotJoshJohnson.xml",
        "ms-edgedevtools.vscode-edge-devtools",
        "ironbee-ai.ironbee-devtools-vscode"
      ],
      "settings": {
        "cursor.chat.autoRun": false
      }
    }
  },
  "remoteEnv": {
    "CATACOMBS": "1"
  },
  "remoteUser": "agent",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/common-utils:2": {
      "configureZshAsDefaultShell": true,
      "username": "agent"
    },
    "ghcr.io/devcontainers/features/node:2": {
      "version": "lts"
    },
    "ghcr.io/jsburckhardt/devcontainer-features/uv:1": {
      "version": "latest"
    },
    "ghcr.io/rails/devcontainer/features/postgres-client:1.2.0": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "mounts": [
    "source=${localWorkspaceFolder}/.devcontainer/home/.ssh,target=/home/agent/.ssh,type=bind",
    "source=${localWorkspaceFolder}/skills-lock.json,target=/home/agent/.skills-lock.json,type=bind",
    "source=${localWorkspaceFolder}/.agents,target=/home/agent/.agents,type=bind",
    "source=${localWorkspaceFolder}/.cursor,target=/home/agent/.cursor,type=bind",
    "source=${localWorkspaceFolder}/.devcontainer/home/.cursor/hooks,target=/home/agent/.cursor/hooks,type=bind,readonly",
    "source=${localWorkspaceFolder}/.devcontainer/home/.cursor/hooks.json,target=/home/agent/.cursor/hooks.json,type=bind,readonly",
    "source=${localWorkspaceFolder}/.devcontainer/home/.cursor/catacombs-security,target=/home/agent/.cursor/catacombs-security,type=bind,readonly",
    "source=${localWorkspaceFolder}/.devcontainer/home/.cursor/catacombs-security.json,target=/home/agent/.cursor/catacombs-security.json,type=bind,readonly",
    "source=${localWorkspaceFolder}/.catacombs-test,target=/repos/.catacombs-test,type=bind,readonly"
  ],
  "postCreateCommand": {
    "ssh-permissions": "sudo chmod 600 /home/agent/.ssh/* 2>/dev/null || true && echo '\nif [ -f \"$HOME/.ssh/id_ed25519_github\" ] && ! ssh-add -l >/dev/null 2>&1; then\n  eval \"$(ssh-agent -s)\" >/dev/null\n  ssh-add \"$HOME/.ssh/id_ed25519_github\" 2>/dev/null || true\nfi' >> /home/agent/.zshrc",
    "playwright-install": "npm install -g playwright && npx playwright install",
    "git-config": "git config --global user.name \"\" && git config --global user.email \"\"",
    "cursor-symlinks": "ln -sf /home/agent/.cursor/rules/* /repos/.cursor/rules"
  }
}